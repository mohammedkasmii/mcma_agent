# MCMA central server -- PRODUCTION agency server (Ubuntu 24.04, /data/mcma).
# Copy to /data/mcma/config/mcma.env (root-owned, mode 0640) and edit. NO secrets
# here. The server already runs unrelated Docker projects: nothing in this
# file may collide with them -- run `mcma-deploy.sh check` before `up`.

MCMA_PROJECT=mcma-central        # fixed: single deployment identity
MCMA_DATA_ROOT=/data/mcma

# Replace with the agency server's LAN address and a FREE port. Never 0.0.0.0.
MCMA_BIND_ADDRESS=192.168.X.X
MCMA_HTTPS_PORT=18443

# Must not overlap any existing Docker network or host route (`check` verifies).
MCMA_NET_SUBNET=172.29.211.0/28
MCMA_CONTAINER_IP=172.29.211.2

# Name or IP in the certificate SAN (used by the healthcheck).
MCMA_TLS_SERVER_NAME=192.168.X.X

MCMA_UID=10001
MCMA_GID=10001

# Production NEVER builds: images arrive via `import-image` (checksum + image-id verified).
MCMA_ALLOW_BUILD=false
MCMA_IMAGE=mcma-central          # fixed: the dedicated repository, nothing else is tagged or run
MCMA_IMAGE_TAG=set-by-build

MCMA_MEM_LIMIT=2g
MCMA_CPUS=2.0
MCMA_PIDS_LIMIT=512
MCMA_SHM_SIZE=512m
