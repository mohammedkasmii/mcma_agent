# MCMA central server -- DEVELOPMENT VM (Ubuntu 26.04, 192.168.11.111).
# Copy to a private location (e.g. /data/mcma-dev/mcma.env), edit, and pass it
# to mcma-deploy.sh with --env-file. Contains NO secrets: keys/certs are files
# under MCMA_DATA_ROOT and are never listed here.

MCMA_PROJECT=mcma-central        # fixed: single deployment identity
MCMA_DATA_ROOT=/data/mcma-dev

# The ONE host address and port published (HTTPS only). Never 0.0.0.0.
MCMA_BIND_ADDRESS=192.168.11.111
MCMA_HTTPS_PORT=18443

# Private bridge network for this project only. Pick a subnet that overlaps
# nothing on the host (`mcma-deploy.sh check` verifies against existing
# Docker networks and host routes). The container gets the STATIC address.
MCMA_NET_SUBNET=172.29.211.0/28
MCMA_CONTAINER_IP=172.29.211.2

# A name or IP that appears in the server certificate's SAN; used by the
# in-container healthcheck to verify the certificate.
MCMA_TLS_SERVER_NAME=192.168.11.111

# Container user (files under MCMA_DATA_ROOT are owned by this uid:gid).
MCMA_UID=10001
MCMA_GID=10001

# Building images is done HERE (the VM). `build` -> verify -> export-image.
MCMA_ALLOW_BUILD=true

# Image. `build` sets the tag; `rollback <tag>` sets it back.
MCMA_IMAGE=mcma-central          # fixed: the dedicated repository, nothing else is tagged or run
MCMA_IMAGE_TAG=dev

# Resource limits (VM: 4 CPUs / 7.3 GiB shared with other work)
MCMA_MEM_LIMIT=2g
MCMA_CPUS=2.0
MCMA_PIDS_LIMIT=512
MCMA_SHM_SIZE=512m
